# Django
# Obrigatória. Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
# O app não sobe com DEBUG=False se a chave estiver vazia, curta ou igual a este exemplo.
DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret
DJANGO_DEBUG=False
# Mantenha localhost e 127.0.0.1: o healthcheck do container usa 127.0.0.1.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Application
APP_TIME_ZONE=America/Cuiaba
APP_PORT=8000
# Interface do host onde a porta é publicada. 127.0.0.1 = só a própria máquina
# (cloudflared rodando no host). Use 0.0.0.0 apenas se precisar de acesso pela rede local.
APP_BIND=127.0.0.1

# Cloudflare Tunnel: o TLS termina na Cloudflare. Ative para marcar cookies como Secure,
# reconhecer HTTPS via X-Forwarded-Proto e usar o IP real (CF-Connecting-IP) no bloqueio
# de força bruta. Exemplo para o domínio app.exemplo.com.br:
#   DJANGO_ALLOWED_HOSTS=app.exemplo.com.br,localhost,127.0.0.1
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://app.exemplo.com.br
APP_BEHIND_CLOUDFLARE=False
# HSTS emitido pelo Django (0 = desligado). Alternativa: ativar HSTS no painel da Cloudflare.
SECURE_HSTS_SECONDS=0

# Bloqueio de login: falhas permitidas por IP e duração do bloqueio.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=60

# Persistent data inside the Docker volume
SQLITE_PATH=/app/data/db.sqlite3
BACKUP_DIR=/app/data/backups
